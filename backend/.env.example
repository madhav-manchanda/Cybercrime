# ==========================================================================
# SIH26184 - Cybercrime Intelligence Platform :: Environment configuration
# ==========================================================================
# Copy to `.env` and adjust. NEVER commit a filled-in `.env`.
# Every value below is a development-safe default unless marked REQUIRED.
# ==========================================================================

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
APP_NAME="Cybercrime Cash-Out Intelligence API"
APP_SLUG="cybercrime-intel"
APP_ENV=development              # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
APP_VERSION=1.0.0
TIMEZONE=Asia/Kolkata

# Comma separated list of allowed CORS origins. Use explicit origins in prod,
# never "*" together with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --------------------------------------------------------------------------
# Security / JWT
# --------------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-min-32-chars-please-rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=cybercrime-intel-api
JWT_AUDIENCE=cybercrime-intel-clients

# Password hashing (Argon2id preferred; bcrypt supported as fallback)
PASSWORD_HASH_ALGORITHM=argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
BCRYPT_ROUNDS=12

# Bootstrap admin created by `python -m scripts.seed` (never hard-coded in code)
BOOTSTRAP_ADMIN_EMAIL=admin@cybercrime.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!Admin#2026
DEMO_USER_PASSWORD=Demo#Passw0rd

# --------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# --------------------------------------------------------------------------
POSTGRES_USER=cybercrime
POSTGRES_PASSWORD=cybercrime
POSTGRES_DB=cybercrime
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full override (takes precedence over the parts above), e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
# "auto" detects PostGIS at startup. Force with "postgis" or "sqlite".
GEO_BACKEND=auto
# Statement timeout applied per-connection on PostgreSQL
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY=2

# --------------------------------------------------------------------------
# Redis (cache + Celery broker/result backend)
# --------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=                 # defaults to REDIS_URL
CELERY_RESULT_BACKEND=             # defaults to REDIS_URL + "/1"
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_WORKER_CONCURRENCY=4
CELERY_BEAT_SCHEDULE_MINUTES=15

# --------------------------------------------------------------------------
# Rate limiting
# --------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory         # memory | redis
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_PREDICT_PER_MINUTE=12
RATE_LIMIT_SYNTHETIC_PER_HOUR=20
RATE_LIMIT_LLM_PER_MINUTE=30

# --------------------------------------------------------------------------
# Caching
# --------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_DASHBOARD_SECONDS=60
CACHE_TTL_ATM_RISK_SECONDS=300
CACHE_TTL_HOTSPOTS_SECONDS=600
CACHE_TTL_MODEL_META_SECONDS=1800

# --------------------------------------------------------------------------
# Logging / observability
# --------------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | console
LOG_SENSITIVE_FIELDS=password,token,access_token,refresh_token,authorization,account_number,api_key,secret,private_key
REQUEST_LOGGING=true
SLOW_REQUEST_MS=1500

# --------------------------------------------------------------------------
# Machine learning
# --------------------------------------------------------------------------
ML_ARTIFACT_DIR=var/ml           # relative to backend/ unless absolute
ML_RANDOM_SEED=42
ML_MIN_TRAIN_SAMPLES=40
ML_PREDICT_TOP_K=10
ML_NEAREST_ATMS_PER_ANCHOR=60
ML_MAX_DISTANCE_KM=75.0
ML_NEGATIVE_SAMPLING_RATIO=6.0
ML_RETRAIN_MIN_CASES=25
ML_EXPLANATION_TOP_FACTORS=8

# --------------------------------------------------------------------------
# Investigator assistant (LLM) - strictly optional, disabled by default.
# The assistant may ONLY summarise structured evidence already stored by this
# backend. It never makes determinations and never invents facts.
# --------------------------------------------------------------------------
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONTEXT_CHARS=12000

# --------------------------------------------------------------------------
# Domain / geography defaults (used by synthetic generator + demos)
# --------------------------------------------------------------------------
DEFAULT_CITY=Lucknow
DEFAULT_CITY_LAT=26.8467
DEFAULT_CITY_LON=80.9462
DEFAULT_TIMEZONE=Asia/Kolkata
DEMO_CASES=60
DEMO_ATMS=140
